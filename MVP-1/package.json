{
  "name": "data-in-sight",
  "description": "Prevención local de exposición accidental de información sensible a IA",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:ui": "vite --config vite.preview.config.ts",
    "test:ui": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "format": "prettier --write src tests preview *.config.ts package.json",
    "format:check": "prettier --check src tests preview *.config.ts package.json",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "libphonenumber-js": "^1.13.15",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@wxt-dev/module-vue": "^1.0.3",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4"
  }
}
